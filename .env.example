# ==========================================
# Database (Neon PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Authentication & Sessions
# ==========================================
# Cryptographic secret key for signing JWT tokens (min 32 characters in production)
AUTH_SECRET="inland_expense_tracker_secret_key_change_me_in_production_min_32_chars!"
# ALLOW_DEV_ACTOR_HEADER="false"

# ==========================================
# Background Worker Authorization
# ==========================================
WORKER_SECRET="inland_expense_tracker_worker_secret_min_32_chars!"
# APP_URL="http://localhost:3000"

# ==========================================
# WhatsApp Gateway (Fonnte)
# ==========================================
# Fonnte Device API Token for sending outbound WhatsApp messages (api.fonnte.com)
FONNTE_TOKEN="your_fonnte_device_api_token"

# Fonnte Webhook Secret Key for verifying incoming callback requests (payload field: secret_key)
FONNTE_WEBHOOK_SECRET="your_fonnte_webhook_secret_key"
# MOCK_FONNTE="false"

# ==========================================
# Storage (Vercel Blob)
# ==========================================
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"
# MOCK_STORAGE="false"

# ==========================================
# AI Vision OCR (Google Gemini)
# ==========================================
GEMINI_API_KEY="your_google_gemini_api_key"
GEMINI_MODEL="gemini-3.6-flash"
# MOCK_GEMINI="false"

# ==========================================
# Google Sheets Reporting & Backup Sync
# ==========================================
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="Sheet1"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# MOCK_SHEETS="false"

# ==========================================
# Scheduled Cron Worker Authorization
# ==========================================
CRON_SECRET="inland_expense_tracker_cron_secret_min_32_chars!"

