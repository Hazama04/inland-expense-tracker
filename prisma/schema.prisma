// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  STAFF   @map("staf")
  FINANCE @map("finance")
  ADMIN   @map("admin")

  @@map("staff_role")
}

enum ExpenseStatus {
  AUTO             @map("auto")
  DIKOREKSI_MANUAL @map("dikoreksi_manual")
  INPUT_MANUAL     @map("input_manual")
  PERLU_REVIEW     @map("perlu_review")

  @@map("expense_status")
}

enum AuditAction {
  CREATED           @map("created")
  CORRECTED         @map("corrected")
  MANUAL_INPUT      @map("manual_input")
  DUPLICATE_FLAGGED @map("duplicate_flagged")
  STATUS_UPDATED    @map("status_updated")
  DELETED           @map("deleted")

  @@map("audit_action")
}

model Staff {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  phoneNumber String    @unique @map("phone_number")
  role        StaffRole @default(STAFF)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  expenses Expense[]

  @@map("staff")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  keywords  String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  expenses Expense[]

  @@map("categories")
}

model Expense {
  id               String        @id @default(uuid()) @db.Uuid
  staffId          String        @map("staff_id") @db.Uuid
  staff            Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  categoryId       String?       @map("category_id") @db.Uuid
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant         String
  transactionDate  DateTime      @map("transaction_date") @db.Date
  amount           Decimal       @db.Decimal(15, 2)
  status           ExpenseStatus @default(AUTO)
  receiptImagePath String?       @map("receipt_image_path")
  rawOcrResponse   Json?         @map("raw_ocr_response")
  confidenceScore  Decimal?      @map("confidence_score") @db.Decimal(5, 4)
  notes            String?
  sheetRowId       String?       @map("sheet_row_id")
  syncedToSheet    Boolean       @default(false) @map("synced_to_sheet")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  auditLogs    AuditLog[]
  syncFailures SyncFailure[]

  @@index([staffId])
  @@index([transactionDate])
  @@index([status])
  @@index([syncedToSheet])
  @@index([categoryId])
  @@index([staffId, transactionDate, amount])
  @@map("expenses")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  expenseId  String?     @map("expense_id") @db.Uuid
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  action     AuditAction
  actorPhone String      @map("actor_phone")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([expenseId])
  @@index([actorPhone])
  @@index([createdAt])
  @@map("audit_log")
}

model SyncFailure {
  id           String   @id @default(uuid()) @db.Uuid
  expenseId    String   @map("expense_id") @db.Uuid
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  attemptCount Int      @default(1) @map("attempt_count")
  lastError    String   @map("last_error")
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([expenseId])
  @@index([resolved])
  @@map("sync_failures")
}
